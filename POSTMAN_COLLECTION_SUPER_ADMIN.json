{
  "info": {
    "_postman_id": "super-admin-real-data-01",
    "name": "Super-Admin Real Data APIs",
    "description": "Collection pour tester les vraies données du Super-Admin\n\n✅ 5 sources de données réelles:\n1. Audit Logs\n2. Health Check Services\n3. CPU Metrics\n4. Memory Metrics\n5. HTTP Traffic Metrics",
